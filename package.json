  "dependencies": {
    "@astryxdesign/core": "0.7.11",
    "@astryxdesign/theme-neutral": "0.7.11",
    "@stylexjs/stylex": "0.19.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dependency-cruiser": "^18.9.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}

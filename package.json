{
  "name": "travel-discovery",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "data:fetch": "node --env-file=.env.local scripts/fetch-travel-data.mjs",
